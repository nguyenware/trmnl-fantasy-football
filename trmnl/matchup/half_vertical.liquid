{% if error %}
<div class="layout layout--col layout--center"><span class="description text--center">{{ error }}</span></div>
{% else %}
<div class="layout layout--col gap--small" style="justify-content: flex-start; align-items: stretch;">
  <div class="flex flex--col" style="align-items: center;">
    <span class="value value--large value--tnums" style="white-space: nowrap;">{{ me.points_text }}{% if has_opp %}-{{ opp.points_text }}{% endif %}</span>
    <span class="label label--small {% if is_live %}label--inverted{% endif %}">{% if is_final %}Final{% elsif is_live %}Live{% else %}Week {{ week }}{% endif %}{% if win_pct %} · {{ win_pct }}% win{% endif %}</span>
    {% if has_opp %}<span class="description" data-clamp="1">vs {{ opp.name }} ({{ opp.record }})</span>{% endif %}
  </div>
  <table class="table table--xsmall">
    <tbody>
    {% for r in rows %}
      <tr>
        <td><span class="label label--small">{{ r.slot }}</span></td>
        <td><span class="label label--small" data-clamp="1">{{ r.me.name }}{% if r.me.injury %} ({{ r.me.injury }}){% endif %}</span></td>
        <td style="text-align: right;"><span class="label label--small {% if r.me.playing %}label--inverted{% endif %}">{% if r.me.state == "pre" %}{{ r.me.game }}{% else %}{{ r.me.points_text }}{% endif %}</span></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% unless is_final %}<span class="label label--small" style="margin-top: auto;">{{ me.left }} left{% if has_opp %} · opp {{ opp.left }} left{% endif %}{% if me.projected_text != "" %} · proj {{ me.projected_text }}{% endif %}</span>{% endunless %}
</div>
{% endif %}

<div class="title_bar">
  <span class="title">{{ me.name | default: title }}</span>
  <span class="instance">Wk {{ week }}</span>
</div>
