{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trmnl-fantasy-football",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Player snapshot (written by the cron below) and the Yahoo OAuth token.
  // KV namespace ids are not secret.
  "kv_namespaces": [
    { "binding": "FANTASY_KV", "id": "277443a9b5d14992907d9e4c1f4c581e" }
  ],

  // Sunday mode: call the team dashboard Worker directly (same account, no
  // public hop). Remove this block if you don't deploy trmnl-team-dashboard,
  // or set TEAM_DASHBOARD_URL instead.
  "services": [
    { "binding": "TEAM_DASHBOARD", "service": "trmnl-team-dashboard" }
  ],

  // Player snapshot refresh (src/snapshot.js), times in UTC: daily early morning Pacific,
  // Sunday after inactives for the early and late games, and before Monday and Thursday night
  // games. Needs Workers Paid (the parse is ~30 ms of CPU; Free allows 10 ms).
  "triggers": { "crons": ["17 11 * * *", "47 15,16 * * SUN", "47 22 * * MON,THU"] },

  "vars": {
    "TIMEZONE": "America/Los_Angeles",
    "SUNDAY_TEAM": "sea",
    // Defaults so polling URLs can be just /sleeper and /sunday.
    "SLEEPER_LEAGUE_ID": "1331829412093505536",
    "SLEEPER_USERNAME": "frenchfryfan"
    // "YAHOO_LEAGUE_ID": ""
  }
}
